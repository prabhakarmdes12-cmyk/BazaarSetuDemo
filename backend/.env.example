# BazaarSetu Production Environment

# === DATABASE ===
# Development/test default is SQLite. Production uses PostgreSQL by setting a
# postgresql:// DATABASE_URL and running `npm run db:generate` or the Docker
# build, both of which prepare Prisma's datasource provider automatically.
# DATABASE_URL="postgresql://user:password@localhost:5432/bazaarsetu?schema=public"
DATABASE_URL="file:./dev.db"
# Optional override used by scripts/prepare-prisma-provider.cjs.
# BAZAARSETU_PRISMA_PROVIDER="sqlite" # or "postgresql"

# === AUTH ===
# REQUIRED in production — the server refuses to start without it (validateEnv fail-fast).
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION"

# === SERVER ===
PORT=5000
NODE_ENV=development

# === CORS ===
# Comma-separated origins the frontend is served from.
# In production set to your deployed frontend URL, e.g. https://bazaarsetu.example.com
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# === PILOT MODE ===
# Enforces one-locality checkout: allowed delivery PINs + shop/customer radius.
# Defaults are the Ashok Nagar / Kanke Road pilot used by `npm run db:seed:pilot`.
BAZAARSETU_PILOT_MODE="false"
BAZAARSETU_PILOT_LOCALITY="Ashok Nagar / Kanke Road"
BAZAARSETU_PILOT_PINCODES="834002,834008"
BAZAARSETU_PILOT_CENTER_LAT="23.375"
BAZAARSETU_PILOT_CENTER_LNG="85.329"
BAZAARSETU_PILOT_RADIUS_KM="5"
BAZAARSETU_PILOT_CHECKOUT_METHODS="DIRECT_UPI,COD,UDHAAR"

# === RAZORPAY (online udhaar payments) ===
# OPTIONAL — leave blank to disable online payment links (the API returns 503).
# Use Razorpay test keys (https://dashboard.razorpay.com/app/keys) in development.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret for the payment-link webhook (/api/webhooks/razorpay).
# Generate any long random string and use it in the dashboard's webhook config.
RAZORPAY_WEBHOOK_SECRET=""

# === SMS OTP (auth) ===
# Development/test: leave empty — the OTP is echoed in the /send-otp response.
# Production REQUIRED — without a provider /send-otp returns 503 and the OTP is
# never echoed. Supported provider: fast2sms (https://www.fast2sms.com).
#   SMS_PROVIDER="fast2sms"
#   SMS_API_KEY="<your fast2sms api key>"
# SMS_SENDER_ID is reserved for future providers (e.g. MSG91) — optional.
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# === VENDOR PAYOUTS (RazorpayX) ===
# OPTIONAL — without this, payout requests return 503 (fail-closed, no faked
# transfers). RazorpayX is Razorpay's payout product; create a separate API key
# pair under the RazorpayX section of the dashboard.
RAZORPAYX_KEY_ID=""
RAZORPAYX_KEY_SECRET=""
# The merchant settlement account number shown in the RazorpayX dashboard.
RAZORPAYX_ACCOUNT_NUMBER=""
# AES-256 key for encrypting bank account numbers at rest (KYC data).
# REQUIRED in production — set to a long random string. Changing it invalidates
# stored bank accounts.
PAYOUT_ENC_KEY=""

# === CHITI CONSOLE / CHITIGRAM BRIDGE ===
# OPTIONAL — BazaarSetu always queues OperationalEventLog rows first. A delivery
# worker can use these values to sign and forward envelopes to Chiti Console.
CHITI_CONSOLE_WEBHOOK_URL=""
CHITI_CONSOLE_WEBHOOK_SECRET=""
