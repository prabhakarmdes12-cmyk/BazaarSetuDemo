{
  "name": "chiti-bazaar-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "node scripts/prepare-prisma-provider.cjs && prisma generate",
    "db:push": "node scripts/prepare-prisma-provider.cjs && prisma db push",
    "db:seed": "ts-node src/seed.ts",
    "test": "jest --runInBand",
    "db:prepare:provider": "node scripts/prepare-prisma-provider.cjs",
    "db:seed:pilot": "ts-node src/seed-pilot.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "razorpay": "^2.9.8",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
